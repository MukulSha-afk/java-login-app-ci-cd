# Copy to .env and edit:  Copy-Item .env.example .env
# Used by docker-compose.yml and local `mvn spring-boot:run` (via $env: in PowerShell)

# MySQL container
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=UserDB

# Spring app -> points at the `db` service when running in Docker,
# points at localhost when running with Maven locally (see HOW-TO-RUN.md)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/UserDB?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpass
