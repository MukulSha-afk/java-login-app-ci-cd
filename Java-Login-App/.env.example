# Copy to .env and edit:  Copy-Item .env.example .env
# Used by docker-compose.yml and local `mvn spring-boot:run` (via $env: in PowerShell)

# MySQL container
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=UserDB

# Spring app -> points at the `db` service when running in Docker,
# points at localhost when running with Maven locally (see HOW-TO-RUN.md)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/UserDB?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpass

# Optional hardening / tuning (defaults shown; see application.properties)
# SESSION_TIMEOUT=30m
# SESSION_COOKIE_SECURE=false   # set true behind HTTPS
# DB_POOL_SIZE=10
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
